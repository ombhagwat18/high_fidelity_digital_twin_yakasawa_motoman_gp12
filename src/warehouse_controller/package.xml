<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>warehouse_controller</name>
  <version>0.0.0</version>
  <description>
    Simulated Yaskawa YRC1000 controller status/alarm/servo layer for the
    digital twin. Field names and gating behaviour mirror the real
    MotoROS2/YRC1000 ROS2 interface so this node is a like-for-like swap
    point when real controller hardware is connected later.
  </description>
  <maintainer email="omm@todo.todo">omm</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>diagnostic_updater</depend>
  <depend>warehouse_interfaces</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
