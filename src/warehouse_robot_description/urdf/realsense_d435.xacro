<?xml version="1.0" ?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="realsense_d435"
               params="camera_name parent_link xyz rpy">

    <link name="${camera_name}_link">
      <visual>
        <geometry><box size="0.090 0.025 0.025"/></geometry>
        <material name="realsense_body"><color rgba="0.15 0.15 0.15 1.0"/></material>
      </visual>
      <collision>
        <geometry><box size="0.090 0.025 0.025"/></geometry>
      </collision>
      <inertial>
        <mass value="0.072"/>
        <inertia ixx="0.000030" ixy="0.0" ixz="0.0"
                 iyy="0.000062" iyz="0.0" izz="0.000062"/>
      </inertial>
    </link>

    <joint name="${parent_link}_to_${camera_name}" type="fixed">
      <parent link="${parent_link}"/>
      <child  link="${camera_name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <link name="${camera_name}_color_optical_frame"/>
    <joint name="${camera_name}_color_optical_joint" type="fixed">
      <parent link="${camera_name}_link"/>
      <child  link="${camera_name}_color_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    </joint>

    <link name="${camera_name}_depth_optical_frame"/>
    <joint name="${camera_name}_depth_optical_joint" type="fixed">
      <parent link="${camera_name}_link"/>
      <child  link="${camera_name}_depth_optical_frame"/>
      <origin xyz="0 -0.015 0" rpy="-1.5708 0 -1.5708"/>
    </joint>

    <gazebo reference="${camera_name}_link">

      <!-- RGB colour sensor — publishes /${camera_name}_color/image_raw -->
      <sensor name="${camera_name}_color_sensor" type="camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <camera name="${camera_name}_color">
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <horizontal_fov>1.2043</horizontal_fov>
          <clip><near>0.1</near><far>10.0</far></clip>
        </camera>
        <plugin name="${camera_name}_color_plugin" filename="libgazebo_ros_camera.so">
          <!-- Use namespace to get /{camera_name}_color/ prefix -->
          <namespace>${camera_name}_color</namespace>
          <frame_name>${camera_name}_color_optical_frame</frame_name>
          <hack_baseline>0.0</hack_baseline>
        </plugin>
      </sensor>

      <!-- Depth sensor — publishes /${camera_name}_depth/image_raw + /points -->
      <sensor name="${camera_name}_depth_sensor" type="depth">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <pose>0 -0.015 0 0 0 0</pose>
        <camera name="${camera_name}_depth">
          <image>
            <width>848</width>
            <height>480</height>
          </image>
          <horizontal_fov>1.5184</horizontal_fov>
          <clip><near>0.1</near><far>10.0</far></clip>
        </camera>
        <plugin name="${camera_name}_depth_plugin" filename="libgazebo_ros_camera.so">
          <namespace>${camera_name}_depth</namespace>
          <frame_name>${camera_name}_depth_optical_frame</frame_name>
          <hack_baseline>0.0</hack_baseline>
          <min_depth>0.1</min_depth>
          <max_depth>10.0</max_depth>
        </plugin>
      </sensor>

    </gazebo>

  </xacro:macro>

</robot>
