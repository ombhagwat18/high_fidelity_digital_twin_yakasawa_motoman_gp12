<launch>
  <arg name="spawn_rviz" default="true" />

  <let name="xacro_path" value="$(find-pkg-share warehouse_robot_description)/urdf/gp12.xacro" />
  <let name="rviz_cfg" value="$(find-pkg-share warehouse_robot_description)/config/robot_display.rviz" />

  <node pkg="robot_state_publisher" exec="robot_state_publisher" output="screen">
    <param name="robot_description" type="str" value="$(command 'xacro $(var xacro_path)')" />
  </node>

  <node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui" output="screen" />

  <node if="$(var spawn_rviz)" pkg="rviz2" exec="rviz2" output="screen" args="-d $(var rviz_cfg)" />
</launch>
