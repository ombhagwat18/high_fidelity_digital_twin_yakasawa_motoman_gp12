<?xml version="1.0"?>
<!--
  conveyor_belt/model.sdf
  -----------------------
  A simple conveyor belt model for Gazebo classic (gazebo11).

  The belt is driven by warehouse_gazebo::ConveyorBeltPlugin (see
  ../../src/conveyor_belt_plugin.cpp), which sets belt_joint's velocity every
  physics update. Retune/command speed at runtime via ROS2:
    ros2 topic pub /conveyor/velocity std_msgs/msg/Float64 "data: 0.2"

  Lives at warehouse_gazebo/models/conveyor_belt/, resolved automatically via
  gazebo_ros's ament-index model-path environment hook — no manual
  GAZEBO_MODEL_PATH wiring needed. Included from warehouse_industrial.world:
    <include>
      <uri>model://conveyor_belt</uri>
      <pose>0.8 0 0 0 0 0</pose>
    </include>
-->
<sdf version="1.6">
  <model name="conveyor_belt">

    <!--
      Keep the belt static=false so Gazebo simulates friction correctly.
      The chassis underneath is held in place by a fixed joint to the world.
    -->
    <static>false</static>

    <!-- ── Chassis (invisible, provides the fixed base) ──────────────────── -->
    <link name="chassis">
      <pose>0 0 0.45 0 0 0</pose>
      <inertial>
        <mass>50.0</mass>
        <inertia>
          <ixx>5.0</ixx><iyy>5.0</iyy><izz>5.0</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="chassis_visual">
        <geometry>
          <box><size>2.2 0.6 0.05</size></box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.2  0.2  0.2  1</diffuse>
        </material>
      </visual>
      <collision name="chassis_collision">
        <geometry>
          <box><size>2.2 0.6 0.05</size></box>
        </geometry>
      </collision>
    </link>

    <!-- ── Belt surface ────────────────────────────────────────────────────── -->
    <link name="belt_link">
      <pose>0 0 0.5 0 0 0</pose>
      <inertial>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.5</ixx><iyy>0.5</iyy><izz>0.5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="belt_visual">
        <geometry>
          <box><size>2.0 0.5 0.02</size></box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.4 0.4 0.4 1</diffuse>
        </material>
      </visual>

      <collision name="belt_collision">
        <geometry>
          <box><size>2.0 0.5 0.02</size></box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <!-- High friction so products move reliably with the belt -->
              <mu>0.9</mu>
              <mu2>0.9</mu2>
              <!-- fdir1 sets the primary friction direction — along belt (X) -->
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1000000.0</kp>
              <kd>100.0</kd>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>

    <!-- ── Fix chassis to world ───────────────────────────────────────────── -->
    <joint name="chassis_to_world" type="fixed">
      <parent>world</parent>
      <child>chassis</child>
    </joint>

    <!-- ── Belt slides along X relative to chassis ───────────────────────── -->
    <joint name="belt_joint" type="prismatic">
      <parent>chassis</parent>
      <child>belt_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <!-- No hard position limits — the plugin manages velocity -->
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>100</effort>
          <velocity>2.0</velocity>
        </limit>
        <dynamics>
          <damping>10.0</damping>
          <friction>0.0</friction>
        </dynamics>
        <use_parent_model_frame>true</use_parent_model_frame>
      </axis>
    </joint>

    <!-- ── ROS2 conveyor plugins ──────────────────────────────────────────── -->

    <!-- Broadcasts belt_joint position/velocity as sensor_msgs/JointState. -->
    <plugin name="conveyor_joint_states" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/conveyor</namespace>
        <remapping>joint_states:=joint_states</remapping>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>belt_joint</joint_name>
    </plugin>

    <!-- Actually drives belt_joint (warehouse_gazebo::ConveyorBeltPlugin).
         Runs continuously from start-up at initial_velocity; retune or command
         a new speed at runtime via `ros2 topic pub /conveyor/velocity
         std_msgs/msg/Float64 "data: 0.2"`. -->
    <plugin name="conveyor_belt_control" filename="libconveyor_belt_plugin.so">
      <joint_name>belt_joint</joint_name>
      <initial_velocity>0.12</initial_velocity>
    </plugin>

  </model>
</sdf>
