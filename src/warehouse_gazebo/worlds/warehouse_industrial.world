<?xml version="1.0"?>
<!--
  warehouse_industrial.world — FIXED
  ====================================
  BUG-FIXES applied:
    1. model://sun       → inline <light> (Fuel DB disabled; model:// sun fails)
    2. model://ground_plane → inline static plane model (same reason)
    3. pick_table <visual> and <collision> had no name="" — SDF error "Required
       attribute[name] in element[visual] is not specified"
    4. model://bin_good / model://bin_defective → inline static box models
       (those model folders never existed in the package)
    5. model://conveyor_belt now resolves correctly after model.config was
       converted from YAML to valid XML (separate fix).
-->
<sdf version="1.6">
  <world name="warehouse">

    <!-- ── Physics ──────────────────────────────────────────────────────────── -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ── Lighting: inline sun (replaces model://sun) ───────────────────── -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.20 0.20 0.20 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.90</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ambient fill light -->
    <light name="ambient_fill" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.4 0.4 0.4 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <direction>0 0 -1</direction>
    </light>

    <!-- ── Ground plane: inline model (replaces model://ground_plane) ─────── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.72 0.70 0.66 1</ambient>
            <diffuse>0.72 0.70 0.66 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Main Conveyor Belt ─────────────────────────────────────────────── -->
    <!--
      model://conveyor_belt resolves to warehouse_gazebo/models/conveyor_belt/
      Now works because model.config was converted from YAML to valid XML.
    -->
    <include>
      <uri>model://conveyor_belt</uri>
      <pose>0.8 0 0 0 0 0</pose>
    </include>

    <!-- ── Pick Area Table ────────────────────────────────────────────────── -->
    <!--
      FIX: <visual> and <collision> inside a model's link MUST have name="..."
      The missing name="" caused: "Required attribute[name] in element[visual]"
      which aborted the entire world-file parse.
    -->
    <model name="pick_table">
      <static>true</static>
      <pose>2.5 0 0.0 0 0 0</pose>
      <link name="table_link">
        <visual name="table_top_visual">
          <geometry><box><size>1.8 1.2 0.05</size></box></geometry>
          <material><ambient>0.40 0.30 0.20 1</ambient><diffuse>0.48 0.36 0.24 1</diffuse></material>
        </visual>
        <collision name="table_top_collision">
          <geometry><box><size>1.8 1.2 0.05</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ── Good Product Bin (green) ──────────────────────────────────────── -->
    <!--
      FIX: model://bin_good never existed in the package. Replaced with an
      inline static box in green to visually mark the "accept" destination.
    -->
    <model name="bin_good">
      <static>true</static>
      <pose>3.0 0.8 0.15 0 0 0</pose>
      <link name="bin_good_link">
        <!-- back wall -->
        <visual name="back_visual">
          <pose>0 -0.2 0 0 0 0</pose>
          <geometry><box><size>0.40 0.02 0.30</size></box></geometry>
          <material><ambient>0.05 0.50 0.05 1</ambient><diffuse>0.07 0.60 0.07 1</diffuse></material>
        </visual>
        <collision name="back_collision">
          <pose>0 -0.2 0 0 0 0</pose>
          <geometry><box><size>0.40 0.02 0.30</size></box></geometry>
        </collision>
        <!-- front wall -->
        <visual name="front_visual">
          <pose>0 0.2 0 0 0 0</pose>
          <geometry><box><size>0.40 0.02 0.30</size></box></geometry>
          <material><ambient>0.05 0.50 0.05 1</ambient><diffuse>0.07 0.60 0.07 1</diffuse></material>
        </visual>
        <collision name="front_collision">
          <pose>0 0.2 0 0 0 0</pose>
          <geometry><box><size>0.40 0.02 0.30</size></box></geometry>
        </collision>
        <!-- left wall -->
        <visual name="left_visual">
          <pose>-0.2 0 0 0 0 0</pose>
          <geometry><box><size>0.02 0.40 0.30</size></box></geometry>
          <material><ambient>0.05 0.50 0.05 1</ambient><diffuse>0.07 0.60 0.07 1</diffuse></material>
        </visual>
        <collision name="left_collision">
          <pose>-0.2 0 0 0 0 0</pose>
          <geometry><box><size>0.02 0.40 0.30</size></box></geometry>
        </collision>
        <!-- right wall -->
        <visual name="right_visual">
          <pose>0.2 0 0 0 0 0</pose>
          <geometry><box><size>0.02 0.40 0.30</size></box></geometry>
          <material><ambient>0.05 0.50 0.05 1</ambient><diffuse>0.07 0.60 0.07 1</diffuse></material>
        </visual>
        <collision name="right_collision">
          <pose>0.2 0 0 0 0 0</pose>
          <geometry><box><size>0.02 0.40 0.30</size></box></geometry>
        </collision>
        <!-- floor -->
        <visual name="floor_visual">
          <pose>0 0 -0.14 0 0 0</pose>
          <geometry><box><size>0.40 0.40 0.02</size></box></geometry>
          <material><ambient>0.04 0.40 0.04 1</ambient></material>
        </visual>
        <collision name="floor_collision">
          <pose>0 0 -0.14 0 0 0</pose>
          <geometry><box><size>0.40 0.40 0.02</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ── Defective Product Bin (red) ───────────────────────────────────── -->
    <!--
      FIX: model://bin_defective never existed. Replaced with inline red bin.
    -->
    <model name="bin_defective">
      <static>true</static>
      <pose>3.0 -0.8 0.15 0 0 0</pose>
      <link name="bin_defective_link">
        <visual name="back_visual">
          <pose>0 -0.2 0 0 0 0</pose>
          <geometry><box><size>0.40 0.02 0.30</size></box></geometry>
          <material><ambient>0.60 0.05 0.05 1</ambient><diffuse>0.70 0.06 0.06 1</diffuse></material>
        </visual>
        <collision name="back_collision">
          <pose>0 -0.2 0 0 0 0</pose>
          <geometry><box><size>0.40 0.02 0.30</size></box></geometry>
        </collision>
        <visual name="front_visual">
          <pose>0 0.2 0 0 0 0</pose>
          <geometry><box><size>0.40 0.02 0.30</size></box></geometry>
          <material><ambient>0.60 0.05 0.05 1</ambient><diffuse>0.70 0.06 0.06 1</diffuse></material>
        </visual>
        <collision name="front_collision">
          <pose>0 0.2 0 0 0 0</pose>
          <geometry><box><size>0.40 0.02 0.30</size></box></geometry>
        </collision>
        <visual name="left_visual">
          <pose>-0.2 0 0 0 0 0</pose>
          <geometry><box><size>0.02 0.40 0.30</size></box></geometry>
          <material><ambient>0.60 0.05 0.05 1</ambient><diffuse>0.70 0.06 0.06 1</diffuse></material>
        </visual>
        <collision name="left_collision">
          <pose>-0.2 0 0 0 0 0</pose>
          <geometry><box><size>0.02 0.40 0.30</size></box></geometry>
        </collision>
        <visual name="right_visual">
          <pose>0.2 0 0 0 0 0</pose>
          <geometry><box><size>0.02 0.40 0.30</size></box></geometry>
          <material><ambient>0.60 0.05 0.05 1</ambient><diffuse>0.70 0.06 0.06 1</diffuse></material>
        </visual>
        <collision name="right_collision">
          <pose>0.2 0 0 0 0 0</pose>
          <geometry><box><size>0.02 0.40 0.30</size></box></geometry>
        </collision>
        <visual name="floor_visual">
          <pose>0 0 -0.14 0 0 0</pose>
          <geometry><box><size>0.40 0.40 0.02</size></box></geometry>
          <material><ambient>0.50 0.04 0.04 1</ambient></material>
        </visual>
        <collision name="floor_collision">
          <pose>0 0 -0.14 0 0 0</pose>
          <geometry><box><size>0.40 0.40 0.02</size></box></geometry>
        </collision>
      </link>
    </model>

  </world>
</sdf>
