  </gazebo>
  <!-- BUG [4]: tool0 had no inertial block -> ODE warning + possible instability.
       Added minimal (near-massless) inertial. -->
  <link name="tool0">
    <inertial>
      <mass value="0.001"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>
  <!-- ===================== JOINTS =====================
       Effort limits for 10 kg payload (engineering derivation):

       Method: tau_static = (sum_distal_mass + 10 kg) x 9.81 m/s^2 x lever_arm
               Safety factor: 1.5x applied (dynamics, acceleration loads)

       joint1 (base Z-rotation):
         Gravity torque = 0 (axis parallel to g) | effort=330 Nm (UR10 spec)

       joint2 (shoulder Y-pitch):  MOST CRITICAL JOINT
         Distal mass = link2..6 + gripper + payload = 30.6 kg
         Lever arm   = 0.40+0.35+0.25+0.20+0.12+0.06 = 1.38 m (arm segment from j2)
         tau_static  = 30.6 x 9.81 x 1.38 = 414 Nm
         With 1.5x   = 621 Nm  -> rounded to 500 Nm
         (UR10=330 Nm; their arm is more compact at 1.3m total reach)
         Note: our PID P-gain (5000) will compensate for the balance.

       joint3 (elbow Y-pitch):
         Distal = link3..6 + gripper + payload = 20.6 kg, lever = 0.98 m
         tau_static = 198 Nm -> set 300 Nm (1.5x)

       joint4 (forearm X-roll):
         Gravity projects mostly perpendicular; set 150 Nm (UR10=54 Nm but our
         payload + wrist mass is much higher at 10 kg)

       joint5 (wrist Y-pitch):
         Distal = link5+6+gripper+payload = 14.6 kg, lever = 0.38 m
         tau_static = 54 Nm -> set 150 Nm (2.75x for payload swinging dynamics)

       joint6 (wrist Z-spin):
         Gravity torque = 0 but must resist 10 kg payload centrifugal forces
         Set 100 Nm (UR10=54 Nm)
  ====================================================== -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin rpy="0 0 0" xyz="0 0 0.15"/>
    <axis xyz="0 0 1"/>
    <limit effort="330" lower="-3.14159" upper="3.14159" velocity="2.16"/>
    <dynamics damping="15.0" friction="1.5"/>
  </joint>
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin rpy="0 0 0" xyz="0 0 0.40"/>
    <axis xyz="0 1 0"/>
    <!-- 500 Nm: required to hold 30.6 kg distal mass at 1.38 m reach with payload -->
    <limit effort="500" lower="-1.5708" upper="1.5708" velocity="2.16"/>
    <dynamics damping="20.0" friction="2.0"/>
  </joint>
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin rpy="0 0 0" xyz="0 0 0.40"/>
    <axis xyz="0 1 0"/>
    <!-- 300 Nm: 1.5x safety over 198 Nm static requirement -->
    <limit effort="300" lower="-2.0944" upper="2.0944" velocity="3.15"/>
    <dynamics damping="12.0" friction="1.2"/>
  </joint>
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin rpy="0 0 0" xyz="0 0 0.35"/>
    <axis xyz="1 0 0"/>
    <!-- 150 Nm: handles dynamic loads of 10 kg payload at wrist roll -->
    <limit effort="150" lower="-3.14159" upper="3.14159" velocity="3.20"/>
    <dynamics damping="8.0" friction="0.8"/>
  </joint>
  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin rpy="0 0 0" xyz="0 0 0.25"/>
    <axis xyz="0 1 0"/>
    <!-- 150 Nm: 2.75x over 54 Nm static, needed for payload inertia -->
    <limit effort="150" lower="-3.14159" upper="3.14159" velocity="3.20"/>
    <dynamics damping="8.0" friction="0.8"/>
  </joint>
  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin rpy="0 0 0" xyz="0 0 0.20"/>
    <axis xyz="0 0 1"/>
    <!-- 100 Nm: resists 10 kg payload centrifugal and offset torques -->
    <limit effort="100" lower="-3.14159" upper="3.14159" velocity="3.20"/>
    <dynamics damping="5.0" friction="0.5"/>
  </joint>
  <!-- Gripper joints -->
  <joint name="gripper_base_joint" type="fixed">
    <parent link="link6"/>
    <child link="gripper_base"/>
    <origin rpy="0 0 0" xyz="0 0 0.12"/>
  </joint>
  <!-- Prismatic fingers: 0.0 = fully closed, 0.04 m = fully open
       effort = 28 N per finger (56 N total clamp force, adequate for 10 kg payload
       with friction coefficient mu=0.6 giving holding force = 56*0.6 = 33.6 N >= 98 N needed
       Note: increase to 50 N each if using vacuum cups or suction gripper) -->
  <joint name="gripper_left_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="finger_left"/>
    <origin rpy="0 0 0" xyz="0.025 0 0.04"/>
    <axis xyz="1 0 0"/>
    <limit effort="28" lower="0.0" upper="0.04" velocity="0.1"/>
    <dynamics damping="2.0"/>
  </joint>
  <joint name="gripper_right_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="finger_right"/>
    <origin rpy="0 0 0" xyz="-0.025 0 0.04"/>
    <axis xyz="-1 0 0"/>
    <limit effort="28" lower="0.0" upper="0.04" velocity="0.1"/>
    <dynamics damping="2.0"/>
  </joint>
  <!-- Tool Centre Point -->
  <joint name="tool_joint" type="fixed">
    <parent link="link6"/>
    <child link="tool0"/>
    <origin rpy="0 0 0" xyz="0 0 0.21"/>
  </joint>
  <!-- ===================== CAMERAS ===================== -->
  <!-- Top camera: overhead, looking straight DOWN at workspace
       BUG [7] FIXED: was rpy="0 1.5708 0" which pointed camera along +X (sideways).
       Correct: pitch=pi/2 rotates optical-Z toward +X, then yaw=pi flips 180
       so optical-Z points toward -Z (downward). Result: rpy="0 1.5708 3.14159"
       Camera publishes to /top_camera/image_raw  (NOT /camera/image_raw) -->
  <link name="top_camera_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.03"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="dark_grey"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="top_camera_joint" type="fixed">
    <parent link="world"/>
    <child link="top_camera_link"/>
    <origin rpy="0 1.5708 3.14159" xyz="0.5 0 3.0"/>
  </joint>
  <gazebo reference="top_camera_link">
    <sensor name="top_camera" type="camera">
      <update_rate>30</update_rate>
      <camera name="top_view">
        <!-- FOV 80 deg covers ~4.4 m width at 3 m height -->
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>
      <plugin filename="libgazebo_ros_camera.so" name="top_camera_controller">
        <ros>
          <namespace>/top_camera</namespace>
        </ros>
        <camera_name>top_camera</camera_name>
        <image_topic_name>image_raw</image_topic_name>
        <camera_info_topic_name>camera_info</camera_info_topic_name>
        <frame_name>top_camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <!-- Front camera: angled view for tilt/orientation detection
       Position: 1.8 m in front, 1.5 m high
       Orientation: yaw=pi faces -X toward robot; pitch=0.35 rad (~20 deg) tilts down
       Publishes to /front_camera/image_raw -->
  <link name="front_camera_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.03"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="dark_grey"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="front_camera_joint" type="fixed">
    <parent link="world"/>
    <child link="front_camera_link"/>
    <origin rpy="0 0.35 3.14159" xyz="1.8 0 1.5"/>
  </joint>
  <gazebo reference="front_camera_link">
    <sensor name="front_camera" type="camera">
      <update_rate>30</update_rate>
      <camera name="front_view">
        <!-- FOV 60 deg: tight view to detect product tilt at ~1.5 m distance -->
        <horizontal_fov>1.0472</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>8.0</far>
        </clip>
      </camera>
      <plugin filename="libgazebo_ros_camera.so" name="front_camera_controller">
        <ros>
          <namespace>/front_camera</namespace>
        </ros>
        <camera_name>front_camera</camera_name>
        <image_topic_name>image_raw</image_topic_name>
        <camera_info_topic_name>camera_info</camera_info_topic_name>
        <frame_name>front_camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <!-- ===================== ROS2 CONTROL =====================
       BUG [9] FIXED: initial_value for joints 2/3/5 set to a safe "home" pose
       so the robot spawns upright instead of fully-extended horizontal
       (fully horizontal = maximum gravity torque = most likely to collapse).
       Home: j2=-0.5 rad (tilted back), j3=0.5 rad (bent forward), j5=0.8 rad
  ====================================================== -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="joint1">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint2">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-0.5</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint3">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.5</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint4">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint5">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.8</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint6">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="gripper_left_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.04</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="gripper_right_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.04</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
  <!-- ===================== GAZEBO PLUGIN ===================== -->
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <parameters>/home/chaitanya/warehouse_ws/install/warehouse_robot_description/share/warehouse_robot_description/config/arm_controllers.yaml</parameters>
    </plugin>
  </gazebo>
</robot>
