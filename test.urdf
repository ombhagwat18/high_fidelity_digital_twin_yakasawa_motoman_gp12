      <origin rpy="0 0 0" xyz="0 0 0.02"/>
      <inertia ixx="0.000347" ixy="0" ixz="0" iyy="0.000533" iyz="0" izz="0.000667"/>
    </inertial>
  </link>
  <gazebo reference="gripper_base">
    <material>Gazebo/Black</material>
  </gazebo>
