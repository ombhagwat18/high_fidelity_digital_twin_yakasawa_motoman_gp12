  <!-- ===================== GRIPPER =====================
       gripper_base: box 0.08 x 0.06 x 0.04 m,  mass = 0.8 kg
         CoM = (0, 0, 0.02)  [geometric centre of box]
         ixx = 0.8*(0.06^2+0.04^2)/12 = 0.8*0.0052/12  = 0.000347
         iyy = 0.8*(0.08^2+0.04^2)/12 = 0.8*0.0080/12  = 0.000533
         izz = 0.8*(0.08^2+0.06^2)/12 = 0.8*0.0100/12  = 0.000667

       finger: box 0.015 x 0.015 x 0.06 m,  mass = 0.15 kg each
         CoM = (0, 0, 0.03)  [geometric centre]
         ixx = iyy = 0.15*(0.015^2+0.06^2)/12 = 0.15*0.003825/12 = 0.0000478
         izz       = 0.15*(0.015^2+0.015^2)/12 = 0.15*0.000450/12 = 0.0000056

       BUG [1]: original gripper_base had no CoM origin -> defaults to (0,0,0)
                but geometry extends from 0 to 0.04 m -> CoM was offset -> FIXED
       BUG [2]: original fingers had no CoM origin and ixx=0.0001 (near-zero
                causing ODE numerical instability)                      -> FIXED
  ====================================================== -->
  <link name="gripper_base">
    <visual>
      <geometry>
        <box size="0.08 0.06 0.04"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.02"/>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.08 0.06 0.04"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.02"/>
    </collision>
    <inertial>
